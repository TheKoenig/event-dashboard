# Copy to .env and adjust
EVENT_DASHBOARD_HOST=127.0.0.1
#EVENT_DASHBOARD_PORT=443
EVENT_DASHBOARD_CONFIG=config.json
EVENT_DASHBOARD_FETCH_TIMEOUT=15
EVENT_DASHBOARD_CACHE_TTL=3600
# Extra CA file/dir to trust, e.g. for a TLS-inspecting corporate proxy (optional)
# EVENT_DASHBOARD_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
EVENT_DASHBOARD_LOG_LEVEL=INFO
# Serve HTTPS (both required; the password is only needed for an encrypted key)
#EVENT_DASHBOARD_SSL_CERTFILE=/path/to/cert.pem
#EVENT_DASHBOARD_SSL_KEYFILE=/path/to/key.pem
#EVENT_DASHBOARD_SSL_KEYFILE_PASSWORD=
# With TLS: plain HTTP port redirecting to HTTPS (0 disables)
#EVENT_DASHBOARD_HTTP_REDIRECT_PORT=80
