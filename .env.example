# Copy to .env and adjust
EVENT_DASHBOARD_HOST=127.0.0.1
EVENT_DASHBOARD_PORT=8000
EVENT_DASHBOARD_CONFIG=config.json
EVENT_DASHBOARD_FETCH_TIMEOUT=15
EVENT_DASHBOARD_CACHE_TTL=300
# Extra CA file/dir to trust, e.g. for a TLS-inspecting corporate proxy (optional)
# EVENT_DASHBOARD_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
EVENT_DASHBOARD_LOG_LEVEL=INFO
